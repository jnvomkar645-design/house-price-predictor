{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1zgIJxCDywt5HzMQ3ZSQ_1-5PX9iLmaCS","timestamp":1778917790783}],"authorship_tag":"ABX9TyPPOafUGmvJNkSca0ecZeE2"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tff0RNJIr0iQ","executionInfo":{"status":"ok","timestamp":1778916541940,"user_tz":-330,"elapsed":41,"user":{"displayName":"Omkar singh Thakur","userId":"17224889313330740540"}},"outputId":"3d9447f9-d9de-492d-b9fc-28c1d998826b"},"outputs":[{"output_type":"stream","name":"stdout","text":["R² Score: 0.9710456034265558\n","Prediction: [74.64285714 35.78571429]\n"]}],"source":["# Step 1: Libraries install\n","import pandas as pd\n","from sklearn.linear_model import LinearRegression\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import mean_squared_error, r2_score\n","import matplotlib.pyplot as plt\n","\n","# Step 2: Simple dataset banana\n","data = {\n","    'Area': [500, 800, 1000, 1200, 1500, 1800, 2000, 2500],\n","    'Rooms': [1, 2, 2, 3, 3, 4, 4, 5],\n","    'Price': [15, 22, 28, 35, 42, 55, 60, 80]\n","}\n","df = pd.DataFrame(data)\n","\n","# Step 3: Model banana\n","X = df[['Area', 'Rooms']]\n","y = df['Price']\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)\n","\n","model = LinearRegression()\n","model.fit(X_train, y_train)\n","\n","# Step 4: Result dekhna\n","y_pred = model.predict(X_test)\n","print(\"R² Score:\", r2_score(y_test, y_pred))\n","print(\"Prediction:\", y_pred)"]}]}